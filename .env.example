# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=falina
DB_PASSWORD=falina
DB_NAME=falina

# Server
PORT=3002

# App
APP_URL=http://localhost:4202
NODE_ENV=development

# Schema sync — dev only. NEVER enable synchronize in production.
DB_SYNCHRONIZE=true

# Redis + background jobs (BullMQ) — wired in a later phase
REDIS_URL=redis://localhost:6379

# AI provider abstraction (available: mock | openai | gemini | anthropic | ollama)
# mock = deterministic offline responses for dev/tests/CI
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Storage (private object storage for coffee images) — wired in a later phase
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Auth (Phase 3)
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
